# Kopieren nach .env und ausfüllen:  cp .env.example .env && nano .env

# --- Telegram (Token von @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Nach dem ersten Start /start an den Bot schicken, Chat-ID hier eintragen
TELEGRAM_CHAT_ID=
# Optional: weitere User-IDs, die freigeben dürfen (Komma-getrennt)
TELEGRAM_ADMIN_IDS=

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- KI-Bilder (platform.openai.com) – leer lassen = keine KI-Bilder ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- WordPress (Benutzer -> Profil -> Anwendungspasswörter) ---
WP_URL=https://urapress.ch
WP_USER=redaksia-bot
WP_APP_PASSWORD=
# publish = sofort online | draft = als Entwurf in WP (zum Testen)
POST_STATUS=publish

# --- Facebook (optional) – leer lassen = kein FB-Knopf ---
# Seiten-ID und langlebiger Seiten-Zugriffstoken (Page Access Token) der FB-Seite
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Ablauf ---
FEEDS=https://shtegu.com/feed/,https://lajmpress.org/feed/,https://alsat.mk/feed/,https://portalix.mk/api/rss.xml,https://albinfo.ch/feed/,https://partner-feeds.20min.ch/rss/20minuten,https://www.b92.net/rss/b92/info,https://telegrafi.com/feeds/feed.rss?geo=CH,https://zhurnal.mk/feed/,https://telegrafi.com/feeds/feed.rss?geo=DE,https://rss.dw.com/rdf/rss-alb-all,https://www.gazetaexpress.com/feed/,https://partner-feeds.20min.ch/rss/20minuten/people,https://www.blick.ch/people-tv/rss.xml,https://www.billboard.com/feed/,https://top-channel.tv/feed/,https://www.balkanweb.com/feed/,https://euronews.al/feed/,https://www.panorama.com.al/feed/,https://tvklan.al/feed/,https://kallxo.com/feed/,https://insajderi.org/feed/,https://www.bing.com/news/search?q=Albaner&format=rss&setlang=de&cc=DE,https://www.bing.com/news/search?q=Kosovaren&format=rss&setlang=de&cc=DE,https://www.bing.com/news/search?q=Albaner+Schweiz&format=rss&setlang=de&cc=CH,https://www.bing.com/news/search?q=Albanian+American&format=rss&setlang=en&cc=US,https://www.bing.com/news/search?q=Albania+Kosovo&format=rss&setlang=en&cc=US
SCAN_TIME=07:30,17:30
TIMEZONE=Europe/Zurich
ARTICLES_PER_DAY=4
MAX_AGE_HOURS=48
CATEGORIES=Zvicër,Diaspora,Kosovë,Shqipëri,Maqedoni e Veriut,Mal i Zi,Lugina e Preshevës,Bota,Ekonomi,Sport,Kulturë & Showbiz
